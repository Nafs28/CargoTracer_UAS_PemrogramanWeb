		},
		{
			"name": "External Resilient APIs",
			"item": [
				{
					"name": "Geocode Query (Nominatim)",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}"}
						],
						"url": "{{base_url}}/api/geocode?q=Rotterdam+Port"
					}
				},
				{
					"name": "Live Weather Query (Open-Meteo)",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}"}
						],
						"url": "{{base_url}}/api/weather?lat=-6.1018&lon=106.8833"
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000"
